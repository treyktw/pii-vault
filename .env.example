# Copy to .env (never commit .env). Values below are for the local docker
# compose database and an OBVIOUSLY FAKE keyring: every key is the same byte
# repeated 32 times. Generate a real keyring with `make keyring`.

# Runtime login (member of pii_vault_app). Never the schema owner.
PII_VAULT_DATABASE_URL=postgres://pii_vault_runtime:runtime-local-only@localhost:55439/pii_vault

# Owner connection, used only by tests/demo to inspect rows and simulate attacks.
PII_VAULT_OWNER_DATABASE_URL=postgres://postgres:postgres-local-only@localhost:55439/pii_vault

# {"<version>": "<base64 32 bytes>"}; new writes use the active version.
# FAKE TEST KEYS: 0x01 * 32 and 0x02 * 32.
PII_VAULT_KEYRING='{"1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=","2":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="}'
PII_VAULT_ACTIVE_KEY_VERSION=2
